# PostgreSQL
POSTGRES_USER=water
POSTGRES_PASSWORD=water_dev_password
POSTGRES_DB=water_crm
DATABASE_URL=postgresql+asyncpg://water:water_dev_password@db:5432/water_crm

# Backend
JWT_SECRET=change_me_in_production
JWT_EXPIRES_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Telegram-бот
# TELEGRAM_DRY_RUN=1 — бот не ходит в Telegram API, сообщения пишутся в лог.
# Для боевого режима укажите токен и TELEGRAM_DRY_RUN=0.
TELEGRAM_DRY_RUN=1
TELEGRAM_BOT_TOKEN=

# Геокодер Яндекс (MVP-2). Без ключа геокодинг выключен (POST /addresses/{id}/geocode -> 503);
# координаты вводятся вручную, как в MVP-1.
YANDEX_GEOCODER_API_KEY=

# Секрет вебхука входящих заявок Telegram (MVP-3). Без него вебхук выключен (503).
# Telegram настраивается на URL .../incoming/telegram/webhook/<секрет>.
TELEGRAM_WEBHOOK_SECRET=
